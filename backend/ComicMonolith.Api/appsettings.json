{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // JwtSettings: no secret is ever stored here. Set JwtSettings__Secret (or JWT_SECRET) in `.env` / the environment.
  // The values below are empty on purpose: every reader treats empty like absent and falls back to its default
  // (the host refuses to start outside Development when the secret is missing or shorter than 32 bytes).
  "JwtSettings": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "ExpiryMinutes": ""
  },

  // PurchaseRecovery (T23): settles chapter purchases left stuck by a crash or restart (the in-memory bus loses saga
  // messages in flight). Runs at startup, then every IntervalMinutes; only touches purchases older than
  // StuckAfterMinutes (keep it well above the 30 s purchase timeout). Env: PurchaseRecovery__Enabled,
  // PurchaseRecovery__StuckAfterMinutes, PurchaseRecovery__IntervalMinutes. Same values as the code defaults.
  "PurchaseRecovery": {
    "Enabled": true,
    "StuckAfterMinutes": 10,
    "IntervalMinutes": 5
  }

  // Deliberately NOT listed here (T12), because an empty string is not the same as an absent key:
  // - ConnectionStrings:<Name>Connection: Banner and Wallet use `Name ?? DefaultConnection`; an empty key would block the fallback.
  // - FrontendUrl: UserAPI uses `config["FrontendUrl"] ?? "http://localhost:5173"`.
  // - Cloudinary:*: set via env (`Cloudinary__CloudName` ...), see `.env.example`.
  // Set all of these through environment variables; `.env.example` lists them.
}
