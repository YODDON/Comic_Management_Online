# Copy to `.env` (never commit it) and replace every CHANGE_ME value. All values here are fake.
# The monolith host (ComicMonolith.Api) loads `.env` once and refuses to start if a database connection
# string is missing, or, outside Development, if the JWT secret is missing or shorter than 32 bytes.
# An unset ASPNETCORE_ENVIRONMENT counts as Production.

# Environment: Development | Production (default when unset)
ASPNETCORE_ENVIRONMENT=Development

# Database connection strings (required: the host fails at startup if one is missing).
# Each module also accepts the config key ConnectionStrings__<Name>Connection (Banner and Wallet also accept
# ConnectionStrings__DefaultConnection). Banner and Wallet share that fallback: if only DefaultConnection is set,
# they share one database.
AUTH_DB_CONNECTION=Server=localhost,1433;Database=AuthDB;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;
CHAPTER_DB_CONNECTION=Server=localhost,1433;Database=ChapterDB;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;
COMIC_DB_CONNECTION=Server=localhost,1433;Database=ComicDB;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;
BANNER_DB_CONNECTION=Server=localhost,1433;Database=BannerDB;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;
MISSION_DB_CONNECTION=Server=localhost,1433;Database=MissionDB;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;
SOCIAL_DB_CONNECTION=Server=localhost,1433;Database=SocialDB;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;
PAYMENT_DB_CONNECTION=Server=localhost,1433;Database=PaymentDB;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;
WALLET_DB_CONNECTION=Server=localhost,1433;Database=WalletDB;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;

# JWT Settings
# Secret: at least 32 bytes. Outside Development the host refuses to start without it.
# This placeholder is deliberately too short, so copying it unchanged fails the check.
JwtSettings__Secret=CHANGE_ME
JwtSettings__Issuer=prn232_comic_api
JwtSettings__Audience=prn232_comic_api
JwtSettings__ExpiryMinutes=60
# Optional aliases, read when the JwtSettings__* variable above is not set (same order as the code):
# JWT_SECRET=CHANGE_ME
# JWT_ISSUER=prn232_comic_api
# JWT_AUDIENCE=prn232_comic_api
# JWT_EXPIRY_MINUTES=60

# gRPC Endpoints (removed with the gRPC calls in T18)
GrpcEndpoints__UserAPI=http://localhost:5054
GrpcEndpoints__ChapterAPI=http://localhost:5115
GrpcEndpoints__WalletAPI=http://localhost:5091
USER_API_URL=http://localhost:5054
# COMIC_API_URL and MISSION_API_URL are not read by any code today.
COMIC_API_URL=http://localhost:5116
CHAPTER_API_URL=http://localhost:5115
MISSION_API_URL=http://localhost:5120
SOCIAL_API_URL=http://localhost:5133
WALLET_API_URL=http://localhost:5091

# Public application URLs
# API_GATEWAY_URL is used by Chapter and Social to call /comics/{id} (replaced by the path-rewrite middleware, T13).
API_GATEWAY_URL=http://localhost:5028
FRONTEND_URL=http://localhost:5173

# Cloudinary
Cloudinary__CloudName=CHANGE_ME
Cloudinary__ApiKey=CHANGE_ME
Cloudinary__ApiSecret=CHANGE_ME
# Optional aliases, read by Banner and Mission when the Cloudinary__* variable above is not set:
# CloudinarySettings__CloudName=CHANGE_ME
# CloudinarySettings__ApiKey=CHANGE_ME
# CloudinarySettings__ApiSecret=CHANGE_ME

# Infrastructure
SQL_SA_PASSWORD=CHANGE_ME
# RabbitMQ (removed when MassTransit moves in-memory, T21)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=localhost
# Redis (removed in T19)
REDIS_CONNECTION=localhost:6379

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

# Google
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# Top-up
TopUp__CoinRate=1

# Bank / VietQR
BankSettings__BankCode=CHANGE_ME
BankSettings__AccountNumber=CHANGE_ME
BankSettings__AccountName=CHANGE_ME
# SePay webhook key: when empty, the webhook rejects every call and no deposit is credited.
BankSettings__SepayApiKey=CHANGE_ME
